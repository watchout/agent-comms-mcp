{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/watchout/agent-comms-mcp/schemas/aun-k0-db-capabilities-v1.schema.json",
  "title": "AUN K0 Database Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "database", "profile", "production_authority", "capabilities", "unsupported", "fail_closed"],
  "properties": {
    "schema_version": { "const": "aun-k0-db-capabilities/v1" },
    "database": { "enum": ["postgresql", "sqlite"] },
    "profile": { "enum": ["production", "unit_conformance"] },
    "production_authority": { "type": "boolean" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_event_history", "atomic_claim", "skip_locked", "listen_notify", "multi_worker_concurrency"],
      "properties": {
        "immutable_event_history": { "type": "boolean" },
        "atomic_claim": { "type": "boolean" },
        "skip_locked": { "type": "boolean" },
        "listen_notify": { "type": "boolean" },
        "multi_worker_concurrency": { "type": "boolean" }
      }
    },
    "unsupported": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fail_closed": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "database": { "const": "postgresql" } } },
      "then": {
        "properties": {
          "profile": { "const": "production" },
          "production_authority": { "const": true },
          "capabilities": {
            "properties": {
              "immutable_event_history": { "const": true },
              "atomic_claim": { "const": true },
              "skip_locked": { "const": true },
              "listen_notify": { "const": true },
              "multi_worker_concurrency": { "const": true }
            }
          },
          "unsupported": { "maxItems": 0 },
          "fail_closed": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "database": { "const": "sqlite" } } },
      "then": {
        "properties": {
          "profile": { "const": "unit_conformance" },
          "production_authority": { "const": false },
          "capabilities": {
            "properties": {
              "immutable_event_history": { "const": true },
              "atomic_claim": { "const": false },
              "skip_locked": { "const": false },
              "listen_notify": { "const": false },
              "multi_worker_concurrency": { "const": false }
            }
          },
          "unsupported": {
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "const": "production_authority" },
              { "const": "skip_locked_claim" },
              { "const": "listen_notify_wake_hint" },
              { "const": "multi_worker_concurrency" }
            ],
            "items": false
          },
          "fail_closed": { "const": true }
        }
      }
    }
  ]
}
