{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/watchout/agent-comms-mcp/schemas/all-agent-communication-manifest-v1.schema.json",
  "title": "All-agent ordinary communication manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "revision", "issued_at", "not_before", "expires_at",
    "owner_decision_ref", "owner_pinned_digest", "sorted_exact_target_tuples", "target_count",
    "target_sha256", "release_commit", "release_tree", "artifact_digest", "policy_digest",
    "revoked_or_superseded_refs"
  ],
  "properties": {
    "schema_version": { "const": "all-agent-communication-manifest/v1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "owner_decision_ref": { "type": "string", "minLength": 1 },
    "owner_pinned_digest": { "$ref": "#/$defs/sha256" },
    "sorted_exact_target_tuples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "target_count": { "type": "integer", "minimum": 1 },
    "target_sha256": { "$ref": "#/$defs/sha256" },
    "release_commit": { "$ref": "#/$defs/gitSha" },
    "release_tree": { "$ref": "#/$defs/gitSha" },
    "artifact_digest": { "$ref": "#/$defs/sha256" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "revoked_or_superseded_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id", "target_repository", "control_source", "active_function", "workspace_id",
        "workspace_path", "runtime_engine", "runtime_profile_ref", "provider_identity_ref",
        "communication_auto_receive", "protected_d1", "discord_mode"
      ],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "target_repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "control_source": { "type": "string", "minLength": 1 },
        "active_function": {
          "enum": [
            "control_source_author", "control_artifact_author", "coordination_recorder",
            "implementation_executor", "evidence_audit_gate", "scenario_verification_gate",
            "operator_acceptance_gate", "protected_surface_gate", "orchestration_controller",
            "runtime_recovery_executor", "revenue_demand_owner", "revenue_sales_owner"
          ]
        },
        "workspace_id": { "type": "string", "minLength": 1 },
        "workspace_path": { "type": "string", "pattern": "^/" },
        "runtime_engine": { "enum": ["codex-exec", "claude-exec"] },
        "runtime_profile_ref": { "type": "string", "minLength": 1 },
        "provider_identity_ref": { "type": "string", "minLength": 1 },
        "communication_auto_receive": { "type": "boolean" },
        "protected_d1": { "type": "boolean" },
        "discord_mode": { "enum": ["native_verified", "aun_gateway_projection"] }
      }
    }
  }
}
