{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-comms-mcp.local/schemas/queue-work-result-v1.schema.json",
  "title": "AUN queue_work_result_v1",
  "type": "object",
  "required": ["schema_version", "ok", "summary", "reply", "evidence", "writeback", "next_action"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "queue_work_result_v1"
    },
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "reply": {
      "type": ["string", "null"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writeback": {
      "type": ["object", "null"],
      "required": ["mode", "repo", "issue_number", "body", "evidence", "idempotency_key", "body_sha256"],
      "properties": {
        "mode": {
          "type": "string",
          "const": "github_issue_comment"
        },
        "repo": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "idempotency_key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "body_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "string",
      "enum": ["reply", "close", "none", "retry"]
    }
  },
  "additionalProperties": false
}
