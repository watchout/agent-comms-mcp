{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "core/**/*.ts",
    "adapters/**/*.ts",
    "bin/**/*.ts",
    "cli/**/*.ts",
    "db/**/*.ts",
    "entrypoints/**/*.ts",
    "hooks/**/*.ts",
    "scripts/**/*.ts",
    "server.ts"
  ]
}
