<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  state-daemon launchd manifest (Issue #323 spec v0.6 §5.3, 補強 #3).

  Install:
    Prefer the durable restore helper so launchd only points at a verified,
    persistent checkout:
      bun scripts/state-daemon-launchagent.ts restore --commit <approved-main-sha> --execute

  Operator notes:
    - WorkingDirectory must point at the persistent repo checkout or build
      artifact the daemon should run against. Do not use an unowned `/tmp` or
      `/private/tmp` detached checkout as a durable LaunchAgent target.
    - DATABASE_URL is required; it is left blank here so the operator must
      set it explicitly before loading. Loading without it makes the daemon
      crash-loop into the KeepAlive throttle until the env is fixed.
    - If DATABASE_URL uses a local socket URL such as
      postgresql:///agent_comms?host=/tmp, PGUSER/USER must be explicit
      because launchd children do not reliably inherit a login user env.
    - StandardErrorPath is the canonical alert sink (see CompositeAlertSink
      in bin/state-daemon.ts).
    - eligibility is DB-only (agents table + agent_type human guard) — no name list; excluded identities come from
      automatic wake. Normal bot rollout is DB-driven: add an enabled agent
      with channel membership and tmux/runtime metadata, and the daemon can
      wake it without a plist edit. STATE_DAEMON_AGENT_ALLOWLIST is valid only
      as a one-target, expiring Issue #917 canary overlay with control/owner,
      rollback, prior-plist, and observed-state evidence; production steady
      state leaves it and every overlay key unset.
    - ThrottleInterval=10 prevents tight-loop crashes from saturating the
      logs / DB.
    - SIG runtime bots are not restarted by this daemon (spec §6.3 / R8 / F5);
      they emit alerts only.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-comms.state-daemon</string>

  <!--
    Bug 1 fix (re-chain msg 250d01b0): bun must be referenced by ABSOLUTE
    path under launchd. The first launch attempt ran with `/usr/local/bin/bun`
    which doesn't exist on this Apple-Silicon host (bun lives in
    `/Users/yuji/.bun/bin/bun`); the daemon crash-looped into the
    ThrottleInterval and never reached `start()`. F14 forbids relative /
    PATH-dependent argv0.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/yuji/.bun/bin/bun</string>
    <string>/Users/yuji/Developer/agent-comms-mcp/bin/state-daemon.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yuji/Developer/agent-comms-mcp</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/yuji/Developer/agent-comms-mcp/logs/state-daemon.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/yuji/Developer/agent-comms-mcp/logs/state-daemon.err.log</string>

  <!--
    Bug 2 fix (re-chain msg 250d01b0): launchd does NOT inherit a login
    shell PATH, so subprocess spawns (`tmux send-keys`, `bash
    scripts/restart-bot.sh`, etc.) fail to resolve binaries that live
    under Homebrew. F15 forbids leaving PATH unset / relying on the
    system default. Pin the prefixes that the daemon actually shells
    out to: Homebrew (Apple Silicon), Homebrew (Intel), and the system
    bins.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>DATABASE_URL</key>
    <string>postgresql://localhost/agent_comms</string>
    <key>STATE_DAEMON_CODEX_RUNNER_ENABLED</key>
    <string>1</string>
    <key>STATE_DAEMON_CODEX_RUNNER_DATABASE_URL</key>
    <string>postgresql:///agent_comms?host=/tmp</string>
    <key>STATE_DAEMON_ALERT_CHANNEL</key>
    <string>1487368919613444156</string>
    <key>PGUSER</key>
    <string>yuji</string>
    <key>USER</key>
    <string>yuji</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
