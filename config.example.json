{
  "agent_id": "my-bot",
  "database_url": "postgresql://localhost/agent_comms",

  "channels": {
    "general":    { "retention_days": null, "description": "General comms (permanent)" },
    "dev-chat":   { "retention_days": 30, "description": "Dev team comms (30-day retention)" }
  },

  "rate_limit": {
    "max_per_minute": 30
  },

  "loop_detection": {
    "max_depth": 10,
    "max_count": 20,
    "window_seconds": 300
  },

  "auth": {
    "mode": "warn",
    "secret_file": "~/.agent-com/secret",
    "replay_window_seconds": 300
  },

  "forwarding": {
    "discord": {
      "webhook_url": null
    },
    "telegram": {
      "bot_token": null,
      "chat_id": null
    },
    "slack": {
      "webhook_url": null
    },
    "line": {
      "channel_token": null,
      "user_id": null
    }
  }
}
