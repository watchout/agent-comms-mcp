{
  "name": "agent-comms-mcp",
  "version": "1.0.0",
  "description": "Push-based agent-to-agent communication MCP server for AI coding assistants",
  "repository": {
    "type": "git",
    "url": "https://github.com/watchout/agent-comms-mcp.git"
  },
  "homepage": "https://github.com/watchout/agent-comms-mcp",
  "bugs": "https://github.com/watchout/agent-comms-mcp/issues",
  "author": "IYASAKA Inc.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "ai-agent",
    "agent-communication",
    "discord",
    "push-notification",
    "bot-to-bot",
    "anthropic",
    "openai"
  ],
  "main": "server.ts",
  "bin": {
    "agent-comms-mcp": "entrypoints/main.ts",
    "agent-com": "cli/index.ts",
    "aun": "bin/aun.ts"
  },
  "files": [
    "server.ts",
    "entrypoints/",
    "adapters/",
    "cli/",
    "core/",
    "db/",
    "bin/",
    "schemas/",
    "config/queue-work-residue-policy.json",
    "hooks/",
    "config.example.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "bun install --no-summary && bun server.ts",
    "test": "bun test tests/",
    "migrate": "bun run db/migrate.ts",
    "seed": "bun run db/seed.ts",
    "dev": "bun --watch server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "discord.js": "^14.25.1",
    "openai": "^6.33.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  }
}
